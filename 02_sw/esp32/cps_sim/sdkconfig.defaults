# ESP32-S3 (8 MB flash, 2 MB in-package PSRAM) power-meter simulator.
CONFIG_IDF_TARGET="esp32s3"

# 8 MB flash, and a 2 MB application partition: NimBLE + console does not fit
# comfortably in the default 1 MB factory partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: NimBLE peripheral only (the ESP32-S3 has no BR/EDR radio, so the
# controller mode knobs the older examples set do not exist here).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y

# Console on UART0 (the CH9102 bridge -> /dev/ttyACMx) so the REPL is reachable
# with the same cable used for flashing.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
