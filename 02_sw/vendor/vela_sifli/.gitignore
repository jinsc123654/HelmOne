.depend
Make.dep
*.o
*.a
*.d
!**/etc/init.d/
!**/etc/init.d/**
*.i
*~
.swp
.*.swp
/core
.gdbinit
cscope.out

# Packed vector map (generated: pack_map.py). Keep the directory in git.
boards/sf32lb52/my_vendor/mkfs/fat/map/**
!boards/sf32lb52/my_vendor/mkfs/fat/map/.gitkeep

# Terrarium DEM cache used by build_vgraph.py
docs/osm/cache/
.mimosa/

# Python 字节码缓存：跑任何工具脚本（docs/tools、scripts、build_vmap 等）都会
# 生成/改动它，跟踪着就每次 `git status` 都脏。2026-09-19 从索引里剔掉。
__pycache__/
*.pyc

# littlefs 构建缓存（构建时自动下载/解压）。跟踪它只会让 `git status` 常年脏。
.cache/

# cmake 生成的安装脚本（`boards/sf32lb52/drivers/**/cmake_install.cmake`）。
# 它们被 cmake 原地重写成"当前构建目录"的风格（staging 前缀在 my_vendor_nsh 与
# my_vendor_nsh-factory 之间来回翻），于是**每建完两个变体 `git status` 就脏**。
# 内容完全由构建决定、没有人工成分，跟踪它没有意义。2026-10-01 从索引里剔掉。
boards/sf32lb52/drivers/**/cmake_install.cmake
