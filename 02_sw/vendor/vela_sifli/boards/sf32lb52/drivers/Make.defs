include platform/lcd/Make.defs
include platform/input/Make.defs
include platform/sensor/Make.defs
include platform/gnss/Make.defs

DEPPATH += --dep-path platform$(DELIM)include$(DELIM)
VPATH += :platform$(DELIM)include$(DELIM)

CFLAGS += -DSOC_BF0_HCPU -DSF32LB52X -DUSE_HAL_DRIVER -Wno-undef
ARCH_SRCDIR = $(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src
CHIP_DRIVERS_DIR = $(ARCH_SRCDIR)$(DELIM)chip$(DELIM)..$(DELIM)drivers
CFLAGS += ${INCDIR_PREFIX}$(CHIP_DRIVERS_DIR)$(DELIM)Include
CFLAGS += ${INCDIR_PREFIX}$(CHIP_DRIVERS_DIR)$(DELIM)cmsis$(DELIM)Include
CFLAGS += ${INCDIR_PREFIX}$(CHIP_DRIVERS_DIR)$(DELIM)cmsis$(DELIM)sf32lb52x
CFLAGS += ${INCDIR_PREFIX}$(CHIP_DRIVERS_DIR)$(DELIM)external$(DELIM)CMSIS$(DELIM)Include
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)chip$(DELIM)board$(DELIM)include
CFLAGS += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)common
CFLAGS += ${shell $(INCDIR) $(INCDIROPT) "$(CC)" $(TOPDIR)$(DELIM)drivers$(DELIM)platform$(DELIM)include}
