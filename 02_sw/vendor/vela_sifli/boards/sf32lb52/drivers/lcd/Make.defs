ifeq ($(CONFIG_LCD),y)
ifeq ($(CONFIG_LCD_USING_ST7789S),y)
  CSRCS += st7789s_lcd.c tk024f3036_panel.c
ifeq ($(CONFIG_LCD_ST7789S_SOFTSPI),y)
  CSRCS += lcd_softspi.c
endif
else
  CSRCS += sf32lb_lcd.c
endif
endif

ifeq ($(CONFIG_LCD_USING_ILI8688E),y)
  CSRCS += ili8688e.c
endif

ifeq ($(CONFIG_LCD_USING_CO5300),y)
  CSRCS += co5300.c
endif

ifeq ($(CONFIG_LCD_USING_NV3031A),y)
  CSRCS += nv3031a.c
endif

DEPPATH += --dep-path lcd
VPATH += :platform/lcd




