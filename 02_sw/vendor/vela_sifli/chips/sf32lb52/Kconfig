            config MYVENDOR_BOARD_PSRAM_POOL_KB
                int "PSRAM pool for board_malloc_psram (KiB)"
                default 11008
                depends on BSP_USING_PSRAM
                ---help---
                    Fixed PSRAM buffer registered as a separate NuttX heap
                    (mm_initialize). Excluded from kumm heap in
                    sifli_allocateheap.c. Set 0 to fall back to SRAM malloc.

                    PSRAM_DATA is 12 MiB. kumm = 12 MiB − this pool − MTP
                    tail (256 KiB). Product: 11008 KiB pool so Umem PSRAM
                    kumm is 1 MiB. LVGL image cache (1 MiB) and map arenas
                    allocate from this pool.

            config MYVENDOR_PSRAM_CACHE_WB
                bool "PSRAM data cache write-back (global)"
                default n
                depends on BSP_USING_PSRAM
                ---help---
                    Build the arch/HAL targets with PSRAM_CACHE_WB: the whole
                    PSRAM window (0x60000000-0x61FFFFFF) turns write-back
                    instead of write-through.

                    Why: store throughput. Write-through costs ~22 cycles per
                    byte (every store goes to the bus); write-back lets the
                    core D-cache absorb them. Measured on the "nationwide hop"
                    workload (bicycle_nsh gnss hop): the CPU copy/scroll
                    segment cyc_begin drops 40%, cold tile load 28%, while
                    tile rasterization (457 KB canvas vs 16 KB D-cache) barely
                    moves.

                    Cost: every non-CPU master touching PSRAM needs cache
                    maintenance (clean before it reads, invalidate after it
                    writes). That work is done and the evidence is in
                    docs/psram_cache_wb_audit.md: EPIC output is invalidated
                    per written row (myvendor_epic_blit.c) and the generic DMA
                    destination is cleaned (bf0_hal_dma.c). To get a
                    write-through baseline for A/B, drop this line from the
                    defconfig and force a reconfigure (see the audit doc).

            comment "Product identity (USB / MTP / BLE / OVNX wrap)"

            config MYVENDOR_PRODUCT_NAME
                string "Product name"
                default "Helm One"
                ---help---
                    Single product name: MTP model, BLE advertised name,
                    USB iProduct. BLE/MTP/USB all append -XXYY from the
                    public BD_ADDR (eFuse UID, same two bytes). Also set
                    CONFIG_USBMTP_PRODUCTSTR in defconfig to the bare
                    name (the MAC suffix is filled at boot). wrap
                    /fw/<version>.bin uses PRODUCT_VERSION, not this.

            config MYVENDOR_PRODUCT_VERSION
                string "Product version (X.Y.Z)"
                default "1.4.2"
                ---help---
                    MTP DeviceInfo version, OVNX header, and firmware slot
                    filename. wrap reads this from defconfig. Bump here when
                    shipping a new image; keep old /fw/*.bin on the device
                    as rollback.

            config MYVENDOR_HARDWARE_VERSION
                string "Hardware version (X.Y.Z)"
                default "1.0.0"
                ---help---
                    Board hardware revision reported over BLE Companion
                    0xFF1A and used as the OTA manifest ?hw= query.  Bump
                    when the PCB or BOM changes.

            config MYVENDOR_MANUFACTURER
                string "Manufacturer"
                default "Helm"
                ---help---
                    MTP GetDeviceInfo manufacturer. Also set
                    CONFIG_USBMTP_VENDORSTR in defconfig to the same string.

            config MYVENDOR_FACTORY_MODE
                bool "Factory firmware (force MTP+BLE, bitmap factory page)"
                default n
                ---help---
                    nsh-factory image only. Do not read persist.usb.mtp
                    or persist.bt.radio; force USB MTP and phone BLE on.
                    Bicycle UI opens a dedicated factory page that uses
                    compiled-in bitmap glyphs (no TTF preload, no LiveMap).

            config MYVENDOR_SELFTEST
                bool "Build the 'test' board self-test command (test lfs/led)"
                default n
                select NSH_DISABLE_TEST
                ---help---
                    Builds the 'test' NSH builtin command, a single dispatcher
                    for the board self-test demos under boards/.../my_vendor/test
                    (e.g. 'test lfs', 'test led', 'test sensor'). Replaces the
                    NSH POSIX 'test' builtin. Run 'test' with no argument to
                    list demos. Shell conditionals still use '['. Each demo is
                    compiled in but only active when its dependencies are
                    enabled.

            config MYVENDOR_IDLE_STAT
                bool "True CPU idle via up_idle WFI + DWT"
                default y
                select ARCH_IDLE_CUSTOM
                ---help---
                    Replace the empty ARM up_idle() loop with WFI and count
                    DWT cycles as true idle. No background syslog; run
                    "test idle" to compare true_idle%% with cpuload PID0.

            config MYVENDOR_DVFS
                bool "HCPU DVFS 72/96/144/240 MHz"
                default y
                ---help---
                    Product governor, not Vela CONFIG_PM. Gears 72/96/144
                    (S0) and 240 (S1). Auto ondemand from PID0 idle (ps
                    IDLE). Charging (ETA9184 STAT low) pins 240; unplug
                    or full releases it. MTP does not touch DVFS.
                    boot/map/off still pin 240. Screen-on (awake) does not.
                    DLL2 stays at 288 MHz so PSRAM/NAND keep running. Does
                    not drop to 48/24 MHz.
                    UI input immediately applies a short interactive floor;
                    sustained load is still governed by PID0 idle.
                    NSH: sys dvfs / ctl dvfs auto|72|96|144|240.

            config MYVENDOR_DVFS_IDLE_UP
                int "Step up if projected idle percent would fall below"
                default 20
                range 1 40
                depends on MYVENDOR_DVFS
                ---help---
                    clock_cpuload PID0, same number as the ps IDLE column.
                    UI latency needs more headroom than throughput-only
                    workloads; 20 percent avoids waiting for saturation.

            config MYVENDOR_DVFS_IDLE_DOWN
