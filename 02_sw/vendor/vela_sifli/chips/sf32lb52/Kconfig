            menuconfig MYVENDOR_BICYCLE
                bool "Build NSH builtin 'bicycle' (X-TRACK UI on /dev/lcd0)"
                default n
                depends on MYVENDOR_LVGL_STACK
                select HAVE_CXX
                # LV_USE_CLIB_* / LIBCXX are "choice" symbols, so `select` on
                # them has no effect (Kconfig drops it with a warning) -- that is
                # why the old `select LIBCXX` line was removed.
                #
                # Do NOT re-add `depends on LIBCXX` here: the C++ Library
                # <choice> depends on HAVE_CXX, HAVE_CXX is selected *by this
                # very symbol*, so requiring LIBCXX closes a Kconfig dependency
                # loop ("Dependency loop" from olddefconfig, breaks a fresh
                # factory configure).
                #
                # This symbol therefore does NOT by itself guarantee libc++;
                # the board defconfig pins CONFIG_LIBCXX=y.  If that ever drifts,
                # the failure surfaces as a C++ link error, not a Kconfig error.
                select LIB_PNG
                select LIB_ZLIB
                select NETUTILS_CJSON
                select LV_FONT_MONTSERRAT_14
                select LV_FONT_MONTSERRAT_16
                select LV_FONT_MONTSERRAT_20
                select LV_FONT_MONTSERRAT_24
                select LV_FONT_MONTSERRAT_26
                select LV_FONT_MONTSERRAT_28
                select LV_FONT_MONTSERRAT_32
                select LV_FONT_MONTSERRAT_36
                select LV_FONT_MONTSERRAT_40
                select LV_FONT_MONTSERRAT_48
                ---help---
                    Compile the bicycle X-TRACK fork (boards/.../my_vendor/bicycle/).
                    LVGL uses myvendor_lcd_disp on /dev/lcd0: partial double
                    buffers (see MYVENDOR_LCD_DISP_STRIP_ROWS), flush via worker
                    + LCDDEVIO_PUTAREA (SPI2 DMA underneath).
                    Assets on LittleFS /mnt/lfs (FS_REGION, NAND or SD/eMMC); edit
                    boards/.../my_vendor/mkfs/, build with build_fs_root.sh, flash fs_root.bin.
                    NSH: bicycle &  (see rcS when MYVENDOR_BICYCLE_AUTOSTART=y)

            if MYVENDOR_BICYCLE

            config MYVENDOR_BICYCLE_AUTOSTART
                bool "Autostart bicycle UI after LCD init"
                default n
                ---help---
                    Spawn the bicycle map/UI task from board lcd_bringup after
                    /dev/lcd0 is ready.  When n, NSH stays headless; start
                    the UI later with:  bicycle &

            config MYVENDOR_BICYCLE_STACKSIZE
                int "bicycle stack size"
                default 34816
                ---help---
                    NuttX carves the argv and TLS frames (96 bytes) off the
                    top of a task's stack, and LVGL checks at init that the
                    usable stack is at least 32768 bytes when freetype or
                    thorvg is enabled.  Leave that headroom here, otherwise
                    boot logs an LVGL "Stack size is too small" error.
                    2026-09-25: default 16384 -> 34816.

            config MYVENDOR_BICYCLE_PRIORITY
                int "bicycle task priority"
                default 100

            config MYVENDOR_BICYCLE_GNSS_GPX_SIM
                bool "Replay GNSS from /mnt/lfs/Track/test.gpx (30 km/h)"
                default n
                depends on BOARD_L96_GNSS
                ---help---
                    Use the GPX simulator HAL instead of the L96 UART driver.
                    Indoor bench: map and sport stats follow test.gpx at fixed speed.
                    Disable to use real L96-M33 NMEA on /dev/ttyS0.

            config MYVENDOR_BICYCLE_C_UI
                bool "C map UI (vmap C + LVGL9 bindings, no X-TRACK)"
                default n
                ---help---
                    Build bicycle with pure-C entry (c/bicycle_c_main.c),
                    C vmap rasterizer, and lv_subject widget bindings.
                    Skips PageManager / DataBroker / C++ MVP stack.

            config MYVENDOR_BICYCLE_INVAL_PROBE
                bool "Log LVGL dirty-rect / flush sources (debug)"
                default n
                depends on MYVENDOR_BICYCLE_C_UI
                ---help---
                    Print [inval] lines for lv_obj_invalidate, display dirty
                    areas, and FLUSH_START (real LCD pushes). Use syslog /
                    LVGL log on serial. Disable for production soak tests.

            config MYVENDOR_BICYCLE_HANDLER_STAT
                bool "Log lv_timer_handler duration (5 s summary)"
                default n
                depends on MYVENDOR_BICYCLE_C_UI
                ---help---
                    Every 5 s print real handler call count, min/avg/max
                    microseconds, estimated handler CPU%, and active LVGL timers.

            config MYVENDOR_BICYCLE_C_DEBUG
                bool "Log C UI soak counters ([bicycle] every 5 s)"
                default n
                depends on MYVENDOR_BICYCLE_C_UI
                ---help---
                    Periodic syslog: main-loop Hz, GPX ticks, track push/draw/skip,
                    map pan vs full render, lap events, point counts, revisions.
                    Use with HANDLER_STAT and INVAL_PROBE when chasing freezes.

            config MYVENDOR_VMAP_TILE_CACHE_KB
                int "Vector map tile cache arena (KiB)"
                default 2048
                depends on BSP_USING_PSRAM
                ---help---
                    Fixed BoardPSRAM arena for cached .vt tile blobs keyed by
                    (cityId, z, x, y). Separate from canvas/render buffers.
                    Increase MYVENDOR_BOARD_PSRAM_POOL_KB accordingly.

            config MYVENDOR_VMAP_VPK_HEAP_KB
                int "Vector map cell vpk RAM heap (KiB)"
                default 1024
                depends on BSP_USING_PSRAM
                ---help---
                    Dedicated BoardPSRAM heap that caches whole cell vpk files
                    so tiles, graphs and portals are not re-read from flash.
                    LRU drops the oldest unused file when a new one does not fit.
                    Increase MYVENDOR_BOARD_PSRAM_POOL_KB accordingly.

            config MYVENDOR_VMAP_TRACK_ARENA_KB
                int "Track overlay arena in BoardPSRAM (KiB)"
                default 1024
                depends on MYVENDOR_BICYCLE_C_UI && BSP_USING_PSRAM
                ---help---
                    Fixed BoardPSRAM bump arena for speed-colored track
                    points and draw samples (on-screen lap polyline).
                    bicycle_config.h sizes this for BICYCLE_MAX_SESSION_KM
                    (default 150 km @ 3 m spacing ≈ 595 KiB + slack).
                    Runtime uses max(Kconfig, bicycle_config_track_arena_bytes()).
                    Sum with tile cache + canvas within MYVENDOR_BOARD_PSRAM_POOL_KB.

            config MYVENDOR_VMAP_CANVAS_MARGIN
                int "Vector map canvas pan margin (pixels per edge)"
                default 192
                range 96 256
                depends on BSP_USING_PSRAM
                ---help---
                    Overscan around the visible viewport: the map can pan this
                    many pixels by translating the canvas before a full re-render.
                    RGB565 canvas size is (viewW + 2*margin) x (viewH + 2*margin).
                    On 240x320, margin 144 ~ 624 KiB canvas; 192 ~ 858 KiB (+231 KiB);
                    256 ~ 1.2 MiB. Uses BoardPSRAM via vmap_malloc.

            endif

