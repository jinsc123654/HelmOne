            config MYVENDOR_WATCHDOG
                bool "Start IWDT; reset if CPU or UI heartbeat stops"
                default y
                depends on WATCHDOG
                depends on MYVENDOR_IDLE_STAT
                ---help---
                    bringup still only registers /dev/watchdog0 first. After
                    board init this STARTs the hardware IWDT. High-priority
