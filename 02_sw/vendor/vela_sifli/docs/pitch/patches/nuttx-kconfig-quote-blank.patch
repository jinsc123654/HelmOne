+      continue()
+    endif()
 
     # Find variable name
-    string(REGEX MATCH "^CONFIG[^=]+" Name ${NameAndValue})
+    string(REGEX MATCH "^CONFIG[^=]+" Name "${NameAndValue}")
 
     if(Name)
       # Find the value
-      string(REPLACE "${Name}=" "" Value ${NameAndValue})
+      string(REPLACE "${Name}=" "" Value "${NameAndValue}")
 
       # remove extra quotes
       if(Value MATCHES "^\"(.*)\"$")
