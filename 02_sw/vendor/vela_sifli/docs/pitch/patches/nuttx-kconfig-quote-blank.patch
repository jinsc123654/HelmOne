diff --git a/cmake/nuttx_kconfig.cmake b/cmake/nuttx_kconfig.cmake
index dedec049e3f..68b089be94f 100644
--- a/cmake/nuttx_kconfig.cmake
+++ b/cmake/nuttx_kconfig.cmake
@@ -44,11 +44,15 @@ function(nuttx_export_kconfig_by_value kconfigfile config)
   foreach(NameAndValue ${ConfigContents})
     decode_brackets(NameAndValue)
     encode_semicolon(NameAndValue)
-    string(REGEX REPLACE "^[ ]+" "" NameAndValue ${NameAndValue})
-    string(REGEX MATCH "^CONFIG[^=]+" Name ${NameAndValue})
+    # Quote: blank .config lines expand to zero args and CMake 3.23+ errors.
+    string(REGEX REPLACE "^[ ]+" "" NameAndValue "${NameAndValue}")
