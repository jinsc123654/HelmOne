<?xml version="1.0" encoding="utf-8"?>
<!--
  状态栏小图标：只有轮廓，靠 alpha 做蒙版。

  之前用的是 @mipmap/ic_launcher —— 那是彩色自适应启动图标，被系统当蒙版用会糊成一团
  灰白块。小图标必须是单色矢量，这里是 24dp 的自行车轮廓（与"码表"这件事对得上，
  且在 24px 下仍能认出来）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 车轮 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M6,16.3 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M18,16.3 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

    <!-- 车架、前叉、车把、车座 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,16.3 L11.6,16.3 L9.6,9.3 Z M9.6,9.3 L17,9.3 M11.6,16.3 L17,9.3 M17,9.3 L18,16.3 M17,9.3 L18.4,7.6 M16.6,7.2 L20.2,7.2 M9.6,9.3 L9.5,8.6 M8,8.4 L11,8.4" />
</vector>
